# Local Development Database Configuration
# Use this file when running with docker-compose locally
DB_HOST=mariadb
DB_PORT=3306
DB_USER=mathis
DB_PASSWORD=mathis
DB_NAME=vehicle_management

# Environment
DEBUG=True
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=Vehicle Management API
PROJECT_DESCRIPTION=API de gestion personnelle des véhicules
VERSION=1.0.0

# CORS (comma-separated string, NO quotes, NO brackets)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3055,http://localhost:8080,*

# Database pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
