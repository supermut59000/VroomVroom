# Copy this file to .env.docker at the repository root:
# cp .env.example .env.docker

# Database — these defaults match the bundled development MariaDB service.
# Replace them when using an external/production database.
DB_HOST=mariadb
DB_PORT=3306
DB_USER=mathis
DB_PASSWORD=mathis
DB_NAME=vehicle_management

# API
API_KEY=
DEBUG=False
ENVIRONMENT=development
# CORS — origines autorisées pour les appels navigateur (PWA).
#   - https://localhost / capacitor://localhost : origine du WebView Capacitor
#     (l'app native passe par la couche HTTP native, mais ces entrées évitent
#     les surprises si elle repasse par fetch)
#   - la PWA publiée sur GitHub Pages
# Ajoute ici l'origine exacte (scheme://hôte[:port], sans chemin) depuis
# laquelle tu ouvres l'app dans un navigateur (LAN, VPN, etc.).
BACKEND_CORS_ORIGINS=http://localhost:3055,https://carmanagement.home.ouiouibaguette.fr,https://carmanagementapi.home.ouiouibaguette.fr,https://localhost,capacitor://localhost,https://supermut59000.github.io
LOG_LEVEL=INFO

# Routing — existing Valhalla server
ROUTING_PROVIDER=valhalla
ROUTING_URL=http://192.168.25.25:8002
ROUTING_PROFILE=driving
ROUTING_PROFILE_VALHALLA=auto
ROUTING_TIMEOUT=8.0
ROUTING_CACHE_TTL=21600
ROUTING_MAX_BATCH=95
ROUTING_MAX_CONCURRENCY=4

# SQLAlchemy pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
